# Room scene with various transparent materials
# Low ambient for better refraction visibility
A 0.03 255,255,255

# Camera positioned to view the room
C 0,5,-15 0,0,1 60

# Main room lighting
L 5,8,-5 0.4 255,255,255  # Main light
L -5,8,-5 0.3 255,220,180  # Warm fill light

# Room walls and floor
pl 0,-3,0 0,1,0 240,240,240 {reflectivity:0.1}  # Floor
pl -8,0,0 1,0,0 230,210,200  # Left wall
pl 8,0,0 -1,0,0 200,210,230  # Right wall
pl 0,0,20 0,0,-1 135,206,235  # Back wall (sky blue)
pl 0,10,0 0,-1,0 255,255,255  # Ceiling

# Glass table (cylinders for legs, plane for top)
cy -3,-3,0 0,1,0 0.2 3 192,192,192 {reflectivity:0.2}  # Left front leg
cy 3,-3,0 0,1,0 0.2 3 192,192,192 {reflectivity:0.2}   # Right front leg
cy -3,-3,4 0,1,0 0.2 3 192,192,192 {reflectivity:0.2}  # Left back leg
cy 3,-3,4 0,1,0 0.2 3 192,192,192 {reflectivity:0.2}   # Right back leg
pl 0,0,2 0,1,0 255,255,255 {refractive_index:1.52 transparency:0.9 reflectivity:0.1}  # Glass top

# Glass of water on the table
cy 0,0,2 0,1,0 0.8 2 255,255,255 {refractive_index:1.52 transparency:1.0 reflectivity:0.1}  # Glass
pl 0,1,2 0,1,0 200,220,255 {refractive_index:1.33 transparency:0.8 reflectivity:0.2}  # Water surface

# Diamond display
sp 3,1,3 0.5 255,255,255 {refractive_index:2.42 transparency:1.0 reflectivity:0.2}  # Diamond
cy 3,0,3 0,1,0 0.2 1 192,192,192 {reflectivity:0.3}  # Stand

# Decorative glass spheres
sp -3,1,3 0.7 220,255,220 {refractive_index:1.52 transparency:0.9 reflectivity:0.1}  # Green tinted glass
sp -3,1,1 0.7 255,220,220 {refractive_index:1.52 transparency:0.9 reflectivity:0.1}  # Red tinted glass

# Background objects for refraction demonstration
sp -5,2,15 1.5 255,100,100 {reflectivity:0.2}  # Red sphere
sp 0,2,15 1.5 100,255,100 {reflectivity:0.2}   # Green sphere
sp 5,2,15 1.5 100,100,255 {reflectivity:0.2}   # Blue sphere

# Some cylinders as decorative elements
cy -6,0,10 0,1,0 0.3 6 255,200,150  # Orange pillar
cy 6,0,10 0,1,0 0.3 6 150,200,255   # Blue pillar 
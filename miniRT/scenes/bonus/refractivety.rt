# Specialized Checkerboard Patterns for Different Objects
A 0.07    255,255,255

C 0,0,-10    0,0,1    70

# AL 0,0,0   0,1,0    8.0    3.0    1.0    255,245,235

# L 8,8,-5 0.06 255,240,220
# L -8,8,-5 0.06 255,240,220

# floor
pl 0,-5,0    0,1,0    255,255,255    {specular:0.2 shininess:40 }

# ceiling
pl 0,10,0    0,-1,0    135,206,235    {specular:0.2 shininess:40 }

# back wall
pl 0,0,12    0,0,-1    135,206,235    {specular:0.2 shininess:40 }

# Checkered front wall
pl 0,0,-15    0,0,1     135,206,235    {specular:0.2 shininess:40 }

# left wall
pl -15,0,0    1,0,0    135,206,235    {specular:0.2 shininess:40 }

# right wall
pl 15,0,0    -1,0,0    135,206,235    {specular:0.2 shininess:40 }


# Row of spheres with different refractivety
sp -8,0,0        3    220,220,220    {specular:0.8 shininess:150 refractive_index:0.8 transparency:0.95 reflectivity:0.98}

sp -4,0,0        3    220,220,220    {specular:0.8 shininess:150 refractive_index:0.98 transparency:0.95 reflectivity:0.98}

sp 0,0,0         3    220,220,220    {specular:0.8 shininess:150 refractive_index:1.3 transparency:0.9 reflectivity:0.9}

sp 4,0,0         3    255,255,255    {specular:0.8 shininess:150 refractive_index:1.5 transparency:0.9 reflectivity:0.9}

sp 8,0,0         3    220,220,220    {specular:0.8 shininess:150 refractive_index:2.42 transparency:0.9 reflectivity:0.9}


# emissive spheres
sp -6.5,6,10     2    200,0,0    {emissive_intensity:1.0 emissive_color:200,0,0 specular:0.5 shininess:20 transparency:0.0 reflectivity:0.2}

sp 0,6,10        2    0,200,0    {emissive_intensity:1.0 emissive_color:0,200,0 specular:0.5 shininess:20 transparency:0.0 reflectivity:0.2}

sp 6.5,6,10      2    0,0,200    {emissive_intensity:1.0 emissive_color:0,0,200 specular:0.5 shininess:20 transparency:0.0 reflectivity:0.2}


# reflective spheres
sp -6.5,-4,6     2    250,250,250    {specular:0.5 shininess:200  reflectivity:0.98}

sp 0,-4,6        2    150,150,150    {specular:0.5 shininess:200 reflectivity:0.98}

sp 6.5,-4,6      2    0,0,0          {specular:0.5 shininess:200  reflectivity:0.98}


sp -6.5,-4,-2    2    250,250,250    {specular:0.5 shininess:200 reflectivity:0.3}

sp 0,-4,-2       2    150,150,150    {specular:0.5 shininess:200 reflectivity:0.3}

sp 6.5,-4,-2     2    0,0,0          {specular:0.5 shininess:200 reflectivity:0.3}

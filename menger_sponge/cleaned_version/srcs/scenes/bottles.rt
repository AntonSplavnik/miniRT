# Basic scene setup
A 0.2 255,255,255
C 0,0,-10 0,0,0 70
L -10,10,-5 0.7 255,255,255

# Ground plane
pl 0,-1.5,0 0,1,0 220,220,220

#FIRST BOTTLE - Liquor
# Bottle body (cylinder)
cy 0,0,0 0,1,0 4 6 0,106,78
# Bottle neck (cylinder)
cy 0,3.5,0 0,-1,0 1.2 2 0,106,78
# Bottle base (flattened cylinder)
cy 0,3,0 0,-1,0 4 0.2 0,106,78
#Bottle cap (cylinder)
cy 0,4.5,0 0,1,0 1.4 0.5 149,119,103
# Glass effect - inner cylinder (to create thickness)
cy 0,0,0 0,-1,0 3.6 5.8 0,180,230
# Detail rings on bottle
cy 0,2.5,0 0,-1,0 4.1 0.2 0,106,25
cy 0,1.5,0 0,-1,0 4.1 0.2 0,106,25
cy 0,0.5,0 0,-1,0 4.1 0.2 0,106,25
cy 0,-0.5,0 0,-1,0 4.1 0.2 0,106,25
cy 0,-1.5,0 0,-1,0 4.1 0.2 0,106,25

#SECOND BOTTLE - Wine
# Bottle body (cylinder)
cy 5,0,0 0,1,0 3 8 15,12,10
# Bottle neck (cylinder)
cy 5,4.5,0 0,-1,0 1 3 92,1,32
#Bottle cap (cylinder)
cy 5,5.5,0 0,1,0 1.1 0.2 92,1,32
# Glass effect - inner cylinder (to create thickness)
cy 5,0,0 0,-1,0 2.8 7.8 0,180,230
# Beige label on wine bottle (wrapped around middle)
cy 5,0.2,0 0,1,0 3.05 1.8 235,227,198
# Add a base ring at the bottom for more definition
cy 5,-1.5,0 0,1,0 3.0 0.1 40,30,25
# Neck ring
cy 5,-3,0 0,-1,0 1.4 0.2 0,106,25

# ICE CUBES
# Ice cube 1 - standard cube
cu -3.2,-0.9,0 1.0 210,235,255

# Ice cube 3 - larger cube at the bottom
cu -3.5,-1.2,0.3 1.2 210,235,255

# Ice cube 4 - small cube on top
#cu -3.0,-0.3,0.5 0.7 210,235,255

# Ice cube 5 - medium cube with slight blue tint
#cu -3.8,-0.7,-0.4 0.9 200,225,255

# Add a small puddle of water under the ice (flattened cylinder)
cy -3.5,-1.45,0.0 0,1,0 2.5 0.05 220,240,255

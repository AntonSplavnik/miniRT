# OBJ file reference
obj scenes/cottage_simplified.obj 0,0,0 0,0,1 70 200,150,100

# Camera configuration
C 0,0,0 0,0,1 70

# Light configuration
L 0,50,0 1.0 255,255,255

# Ground plane
pl 0,0,0 0,1,0 255,255,255

# Main cottage structure (represented as a cube)
cu -3,7,-2.5 30,14,7 255,200,150

# Roof (represented as a plane)
pl -3,14,-2.5 0,1,0 200,100,100

# Windows (represented as spheres)
sp -10,9,-5.9 2 200,200,255
sp 4,9,-5.9 2 200,200,255

# Door (represented as a cylinder)
cy -3,3.5,-5.9 0,1,0 4 7 150,100,50

# Chimney (represented as a cylinder)
cy 8,15.5,-5.9 0,1,0 4 3 150,150,150

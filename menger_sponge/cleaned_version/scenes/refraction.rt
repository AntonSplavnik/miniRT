A 0.2 255,255,255
C 0,0,-15 0,-0.3,1 70
L 8,10,-5 0.7 255,255,255
L -8,8,-10 0.6 255,240,220

# Glass sphere - adjusted transparency and added some reflectivity
sp 0,0,0 6.0 {color:255,255,255 transparency:0.9 reflectivity:0.1 refractive_index:1.52}

# Checkerboard plane - flipped normal to point up and adjusted position
pl 0,-8,0 0,1,0 {color:255,255,255 reflectivity:0.2 transparency:0.0 refractive_index:0.0 checker_color:255,0,0 checker_size:2.0}

# Colored cube - moved closer and adjusted position
cu 5,-2,3 3.0 {color:0,255,0 reflectivity:0.3 transparency:0.0 refractive_index:0.0}
